{
  "name": "@graphql-inspector/action",
  "version": "5.0.21",
  "type": "module",
  "description": "GraphQL Inspector functionality for GitHub Actions",
  "repository": {
    "type": "git",
    "url": "step-security/graphql-inspector",
    "directory": "packages/action"
  },
  "author": {
    "name": "StepSecurity",
    "url": "https://github.com/step-security"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "graphql-inspector-github": "dist/cjs/index.js"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./*": {
      "require": {
        "types": "./dist/typings/*.d.cts",
        "default": "./dist/cjs/*.js"
      },
      "import": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "default": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "keywords": [
    "graphql",
    "graphql-inspector",
    "tools",
    "probot",
    "probot-plugin",
    "github"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "rm -rf dist/",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@actions/core": "2.0.3",
    "@actions/github": "8.0.1",
    "@graphql-inspector/core": "*",
    "@whatwg-node/fetch": "0.10.3",
    "axios": "^1.18.1",
    "dataloader": "2.2.2",
    "graphql": "16.10.0",
    "js-yaml": "4.3.0",
    "probot": "14.3.2",
    "tslib": "2.6.2"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9"
  },
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
